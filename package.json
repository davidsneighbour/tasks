{
  "name": "@davidsneighbour/tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "NODE_OPTIONS=--experimental-sqlite tsx watch --env-file-if-exists=.env src/server/server.ts",
    "stop": "fuser -k 3070/tcp 5173/tcp 2>/dev/null; true",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_OPTIONS=--experimental-sqlite node --env-file-if-exists=.env dist/server/server.js",
    "check": "npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:biome": "biome check",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\" \"!PROJECT.md\" \"!TODO.md\" \"!scratch/**\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\" \"!PROJECT.md\" \"!TODO.md\" \"!scratch/**\"",
    "lint:secrets": "dnb-secretlint \"**/*\"",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--experimental-sqlite tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "auth:setup": "NODE_OPTIONS=--experimental-sqlite tsx --env-file-if-exists=.env src/server/google/auth-setup.ts",
    "task:add": "NODE_OPTIONS=--experimental-sqlite tsx --env-file-if-exists=.env src/server/tasks/cli-add.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dnbhq/biome-config": "0.3.1",
    "@dnbhq/markdownlint-config": "2.0.0",
    "@dnbhq/secretlint-config": "0.1.1",
    "@dnbhq/tsconfig": "0.1.6",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.0",
    "katex": "0.18.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "markdownlint-rule-title-case-style": {
      "markdownlint": {
        "markdown-it": "14.3.1"
      }
    }
  }
}
